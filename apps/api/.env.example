DATABASE_URL="postgresql://user:password@localhost:5432/eteronhub?schema=public"
PORT=3000
# Obrigatório (a API não sobe sem). Gere um valor próprio, mesmo em dev:
# `openssl rand -base64 48`. O valor de exemplo "change-me-in-production" é
# recusado em qualquer ambiente; com NODE_ENV=production exige >= 32 caracteres.
JWT_SECRET=""
# Origem(ns) do frontend permitidas via CORS, separadas por vírgula. Em
# produção é obrigatório e não aceita '*' nem localhost.
CORS_ORIGIN="http://localhost:3002"
# Quantos proxies/load balancers confiáveis ficam na frente da API (0 = acesso
# direto). Sem isso atrás de um LB, o rate limit trata todos como um só IP;
# com valor maior que o real, o cliente consegue falsificar o próprio IP.
TRUST_PROXY_HOPS=0

# Usados apenas pelo script de seed (prisma/seed.ts) para garantir o primeiro admin
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@eteronhub.com"
ADMIN_PASSWORD="changeme123"

# Integração direta com a API Pix do Banco Inter (docs/03-arquitetura-tecnica.md,
# seção 4). Só são lidas no primeiro uso real (criar cobrança/consultar status),
# então a aplicação sobe normalmente em dev/teste sem elas configuradas.
# Confirme o host correto (produção/sandbox) na documentação oficial do Banco
# Inter antes de usar — não copiado de nenhuma fonte verificada aqui.
BANCO_INTER_BASE_URL="https://REPLACE-WITH-BANCO-INTER-HOST"
BANCO_INTER_CLIENT_ID=""
BANCO_INTER_CLIENT_SECRET=""
BANCO_INTER_CERT_PATH="./certs/banco-inter-cert.pem"
BANCO_INTER_KEY_PATH="./certs/banco-inter-key.pem"
BANCO_INTER_PIX_KEY=""
# Recomendado em produção (ver docs/05-operacao-e-lancamento.md): segredo
# combinado para validar a origem do webhook via header x-webhook-secret.
# Sem esta variável, o webhook não valida nada além da assinatura de payload.
BANCO_INTER_WEBHOOK_SECRET=""
