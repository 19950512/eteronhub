DATABASE_URL="postgresql://user:password@localhost:5432/eteronhub?schema=public"
PORT=3000
JWT_SECRET="change-me-in-production"

# Usados apenas pelo script de seed (prisma/seed.ts) para garantir o primeiro admin
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@eteronhub.com"
ADMIN_PASSWORD="changeme123"

# Integração direta com a API Pix do Banco Inter (docs/03-arquitetura-tecnica.md,
# seção 4). Só são lidas no primeiro uso real (criar cobrança/consultar status),
# então a aplicação sobe normalmente em dev/teste sem elas configuradas.
# Confirme o host correto (produção/sandbox) na documentação oficial do Banco
# Inter antes de usar — não copiado de nenhuma fonte verificada aqui.
BANCO_INTER_BASE_URL="https://REPLACE-WITH-BANCO-INTER-HOST"
BANCO_INTER_CLIENT_ID=""
BANCO_INTER_CLIENT_SECRET=""
BANCO_INTER_CERT_PATH="./certs/banco-inter-cert.pem"
BANCO_INTER_KEY_PATH="./certs/banco-inter-key.pem"
BANCO_INTER_PIX_KEY=""
