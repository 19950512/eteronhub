generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

model Company {
  id           String         @id @default(uuid())
  cnpj         String         @unique
  razaoSocial  String
  nomeFantasia String?
  email        String         @unique
  passwordHash String
  status       CompanyStatus  @default(ACTIVE)
  sector       CompanySector?
  city         String?
  state        String?
  whatsapp     String?
  website      String?
  createdAt    DateTime       @default(now())
}

enum CompanySector {
  METALURGIA
  ESTRUTURA_METALICA
  CALDEIRARIA
  SOLDAGEM
  USINAGEM
  FUNDICAO
  SERRALHERIA
  MANUTENCAO_INDUSTRIAL
  AUTOMACAO
  OUTROS
}

enum WorkerStatus {
  ACTIVE
  SUSPENDED
}

model Worker {
  id           String          @id @default(uuid())
  cpf          String          @unique
  nome         String
  email        String          @unique
  passwordHash String
  status       WorkerStatus    @default(ACTIVE)
  phone        String?
  bio          String?
  segments     WorkerSegment[] @default([])
  // why: lista curta (máx. 20) sempre lida e gravada junto do perfil, sem
  // consulta por software — JSON evita uma tabela só para isso.
  softwares    Json            @default("[]")
  createdAt    DateTime        @default(now())
}

enum WorkerSegment {
  TORRES
  GALPOES
  ESTRUTURAS_RESIDENCIAIS
  ESTRUTURAS_COMERCIAIS
  ESTRUTURAS_INDUSTRIAIS
  PONTES_VIADUTOS
  PLATAFORMAS
  ESCADAS_CORRIMAOS
  PORTOES_GRADES
  COBERTURA_METALICA
  MEZANINO
  TUBULACAO
  CALDEIRARIA
  MONTAGEM_INDUSTRIAL
  MANUTENCAO_INDUSTRIAL
  OUTRO
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum JobPostingStatus {
  DRAFT
  IN_MODERATION
  PUBLISHED
  REJECTED
  CLOSED
  EXPIRED
}

// companyId não é uma relação Prisma (@relation) de propósito: cada agregado
// (Company, JobPosting) é dono da própria tabela e os módulos só se referenciam
// por id, sem joins do ORM entre bounded contexts — ver docs/02-modelo-de-dominio.md.
model JobPosting {
  id              String           @id @default(uuid())
  companyId       String
  title           String
  description     String
  requirements    String
  salaryMinCents  Int
  salaryMaxCents  Int
  location        String
  contactEmail    String?
  contactPhone    String?
  contactUrl      String?
  unlockCost      Int
  status          JobPostingStatus @default(DRAFT)
  rejectionReason String?
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())

  @@index([companyId])
  @@index([status])
}

enum ModerationDecisionType {
  APPROVED
  REJECTED
}

model ModerationDecision {
  id           String                 @id @default(uuid())
  jobPostingId String
  adminId      String
  decision     ModerationDecisionType
  reason       String?
  decidedAt    DateTime               @default(now())

  @@index([jobPostingId])
}

model CreditWallet {
  id        String   @id @default(uuid())
  workerId  String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum CreditTransactionType {
  TOPUP
  DEBIT
}

model CreditTransaction {
  id                 String                @id @default(uuid())
  walletId           String
  type               CreditTransactionType
  amount             Int
  // invariant: no máximo um crédito por pagamento — última barreira contra
  // crédito em dobro se duas confirmações concorrentes passarem do caso de uso.
  relatedPaymentId   String?               @unique
  relatedJobUnlockId String?
  createdAt          DateTime              @default(now())

  @@index([walletId])
}

model CreditPackage {
  id            String  @id @default(uuid())
  name          String
  priceCents    Int
  creditsAmount Int
  active        Boolean @default(true)
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
}

model Payment {
  id              String        @id
  workerId        String
  creditPackageId String
  amountCents     Int
  creditsAmount   Int
  status          PaymentStatus @default(PENDING)
  pixTxId         String        @unique
  pixE2eId        String?
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  confirmedAt     DateTime?

  @@index([workerId])
  @@index([status])
}

model JobUnlock {
  id           String   @id @default(uuid())
  workerId     String
  jobPostingId String
  creditsSpent Int
  unlockedAt   DateTime @default(now())

  // Garante, no nível do banco, que duas transações concorrentes de
  // desbloqueio para o mesmo par nunca resultem em dois registros — ver
  // apps/api/src/modules/job-unlock/infra/persistence/prisma-job-unlock.writer.ts.
  @@unique([workerId, jobPostingId])
  @@index([workerId])
}

// invariant: com várias réplicas da API, cada job agendado roda em no máximo
// uma delas por vez — ver apps/api/src/infra/scheduling/job-lease.service.ts.
model JobLease {
  name        String   @id
  owner       String
  lockedUntil DateTime
}
