generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

model Company {
  id           String        @id @default(uuid())
  cnpj         String        @unique
  razaoSocial  String
  nomeFantasia String?
  email        String        @unique
  passwordHash String
  status       CompanyStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
}

enum WorkerStatus {
  ACTIVE
  SUSPENDED
}

model Worker {
  id           String       @id @default(uuid())
  cpf          String       @unique
  nome         String
  email        String       @unique
  passwordHash String
  status       WorkerStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum JobPostingStatus {
  DRAFT
  IN_MODERATION
  PUBLISHED
  REJECTED
  CLOSED
  EXPIRED
}

// companyId não é uma relação Prisma (@relation) de propósito: cada agregado
// (Company, JobPosting) é dono da própria tabela e os módulos só se referenciam
// por id, sem joins do ORM entre bounded contexts — ver docs/02-modelo-de-dominio.md.
model JobPosting {
  id              String           @id @default(uuid())
  companyId       String
  title           String
  description     String
  requirements    String
  salaryMinCents  Int
  salaryMaxCents  Int
  location        String
  contactEmail    String?
  contactPhone    String?
  contactUrl      String?
  unlockCost      Int
  status          JobPostingStatus @default(DRAFT)
  rejectionReason String?
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())

  @@index([companyId])
  @@index([status])
}

enum ModerationDecisionType {
  APPROVED
  REJECTED
}

model ModerationDecision {
  id           String                 @id @default(uuid())
  jobPostingId String
  adminId      String
  decision     ModerationDecisionType
  reason       String?
  decidedAt    DateTime               @default(now())

  @@index([jobPostingId])
}

model CreditWallet {
  id        String   @id @default(uuid())
  workerId  String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum CreditTransactionType {
  TOPUP
  DEBIT
}

model CreditTransaction {
  id                 String                @id @default(uuid())
  walletId           String
  type               CreditTransactionType
  amount             Int
  relatedPaymentId   String?
  relatedJobUnlockId String?
  createdAt          DateTime              @default(now())

  @@index([walletId])
}

model CreditPackage {
  id            String  @id @default(uuid())
  name          String
  priceCents    Int
  creditsAmount Int
  active        Boolean @default(true)
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
}

model Payment {
  id              String        @id
  workerId        String
  creditPackageId String
  amountCents     Int
  creditsAmount   Int
  status          PaymentStatus @default(PENDING)
  pixTxId         String        @unique
  pixE2eId        String?
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  confirmedAt     DateTime?

  @@index([workerId])
  @@index([status])
}

model JobUnlock {
  id           String   @id @default(uuid())
  workerId     String
  jobPostingId String
  creditsSpent Int
  unlockedAt   DateTime @default(now())

  // Garante, no nível do banco, que duas transações concorrentes de
  // desbloqueio para o mesmo par nunca resultem em dois registros — ver
  // apps/api/src/modules/job-unlock/infra/persistence/prisma-job-unlock.writer.ts.
  @@unique([workerId, jobPostingId])
  @@index([workerId])
}
