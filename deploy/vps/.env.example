# Copie para deploy/vps/.env na VPS (chmod 600). Nunca versione o .env real.
# Gere os segredos com: openssl rand -hex 24 (senha do banco) e openssl rand -base64 48 (JWT).
POSTGRES_PASSWORD=""
JWT_SECRET=""

# Admin inicial criado pelo seed (prisma/seed.ts). Troque a senha após o primeiro login.
ADMIN_NAME="Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Pix (Banco Inter). Vazios = a API sobe normalmente, mas a compra de créditos falha
# até serem preenchidos. Os certificados mTLS precisam ser montados no container.
BANCO_INTER_BASE_URL=""
BANCO_INTER_CLIENT_ID=""
BANCO_INTER_CLIENT_SECRET=""
BANCO_INTER_CERT_PATH=""
BANCO_INTER_KEY_PATH=""
BANCO_INTER_PIX_KEY=""
BANCO_INTER_WEBHOOK_SECRET=""
